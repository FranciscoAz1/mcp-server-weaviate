# Weaviate Connection
WEAVIATE_HOST=host.docker.internal:8080
WEAVIATE_SCHEME=http

# MCP Server Configuration
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=127.0.0.1

# Logging
MCP_LOG_LEVEL=info
MCP_LOG_OUTPUT=stderr

# Security
MCP_READ_ONLY=false
# Comma-separated list of tools to disable
# Available tools: weaviate-query, weaviate-generate-text, weaviate-origin, weaviate-follow-ref
MCP_DISABLED_TOOLS=weaviate-follow-ref,weaviate-origin

# Collections
MCP_DEFAULT_COLLECTION=Dataset
